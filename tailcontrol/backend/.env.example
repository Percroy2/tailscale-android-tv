PORT=3000
DATABASE_URL=postgresql://tailcontrol:tailcontrol@localhost:5433/tailcontrol
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=90d
MASTER_ENCRYPTION_KEY=change-me-32-byte-master-key-base64
WEB_BASE_URL=http://localhost:8080

# OAuth Tailscale (configuré par tailnet via portail → Paramètres)
# Créez un OAuth client sur https://login.tailscale.com/admin/settings/oauth
# Puis enregistrez clientId + clientSecret via POST /api/v1/tailnets/:id/credentials
# Le secret est chiffré AES-256-GCM avant stockage PostgreSQL.
TAILSCALE_OAUTH_SCOPES=devices:core dns:read dns:write policy:read users:read
